<?xml version="1.0" encoding="utf-8"?>
<!-- Ten-foot layout: identity and instructions on the left, a D-pad action column on the right.
     Horizontal padding keeps content inside the 5% overscan margin of older televisions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="72dp"
    android:paddingRight="72dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingRight="48dp">

        <TextView
            android:id="@+id/receiver_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="44sp" />

        <TextView
            android:id="@+id/receiver_activity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/accent"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/receiver_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:lineSpacingMultiplier="1.25"
            android:maxWidth="440dp"
            android:text="@string/instructions"
            android:textColor="@color/text_secondary"
            android:textSize="17sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="264dp"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <Button
            android:id="@+id/rename_button"
            style="@style/TelevisionButton"
            android:nextFocusUp="@+id/restart_button"
            android:text="@string/rename_button" />

        <Button
            android:id="@+id/resolution_button"
            style="@style/TelevisionButton"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/start_on_boot_button"
            style="@style/TelevisionButton"
            android:layout_marginTop="10dp" />

        <Button
            android:id="@+id/restart_button"
            style="@style/TelevisionButton"
            android:layout_marginTop="10dp"
            android:nextFocusDown="@+id/rename_button"
            android:text="@string/restart_button" />
    </LinearLayout>
</LinearLayout>
